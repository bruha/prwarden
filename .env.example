# Two delivery gates: set this to 0 and also pass --live.
AUTO_REVIEW_DRY_RUN=1

# Local private configuration and state.
REPOSITORIES_FILE=repositories.json
STATE_FILE=.state/review-state.json
# Case-insensitive PR labels that are treated like draft status.
EXCLUDED_PR_LABELS=["in progress"]

# Review engine adapter and provider-neutral settings.
# Built-ins: antigravity, codex, claude, kiro. Use command for a custom wrapper.
REVIEW_ENGINE=antigravity
# Optional JSON command override; leave unset for the built-in executable name.
# It belongs to the REVIEW_ENGINE named above: choosing another engine with --engine
# or with REVIEW_ENGINE in the environment drops this command and REVIEW_MODEL, since
# neither can mean anything to a different provider. Set them in the environment too
# when you want them for the engine you switched to.
# REVIEW_ENGINE_COMMAND=["/absolute/path/to/provider-cli"]
# Extra variables to pass through; unrelated secrets are removed.
REVIEW_ENGINE_ENV_ALLOWLIST=[]
# Optional provider model ID; empty uses the adapter default.
REVIEW_MODEL=
# Optional second engine that judges candidate findings, so one model's priors
# are not the only judge of its own output. Built-ins only: antigravity, codex,
# claude, kiro. Leave empty to verify with the primary engine.
# REVIEW_VERIFY_ENGINE=kiro
# Optional model for the verification engine; requires REVIEW_VERIFY_ENGINE.
# REVIEW_VERIFY_MODEL=claude-opus-5.5
# Optional second engine that reviews when the primary engine itself fails, for
# example when a provider is unavailable or refuses the request, at the design,
# documentation, and code levels alike. Built-ins only: antigravity, codex,
# claude, kiro. Validation failures never hand over, and delivered feedback names
# the engine that actually reviewed.
# REVIEW_FALLBACK_ENGINE=claude
# Optional model for the fallback engine; requires REVIEW_FALLBACK_ENGINE.
# REVIEW_FALLBACK_MODEL=claude-opus-4.8
# Optional engine that verifies when the verification engine itself fails, so the
# findings of a fallback review can still be verified and delivered while the
# verifier's provider is down. Requires REVIEW_VERIFY_ENGINE; built-ins only. Only
# an engine failure hands over, and delivered feedback names the verifier that
# actually judged. Pick a model other than the reviewer's, or it judges itself.
# REVIEW_VERIFY_FALLBACK_ENGINE=claude
# REVIEW_VERIFY_FALLBACK_MODEL=claude-sonnet-5-5
# Optional reasoning effort per role: low, medium, high, xhigh, or max. Empty runs
# the model at its own default. Only the kiro, antigravity, and claude adapters pass
# an effort, so naming one for another engine is refused rather than ignored, and a
# misspelt level is refused here because Kiro would quietly run its default.
# Which levels a model takes is the provider's to say: Antigravity refuses one its
# model does not support. REVIEW_CODE_EFFORT overrides REVIEW_EFFORT for the code
# level alone, which is the one that can approve. Switching REVIEW_ENGINE drops the
# reviewer's effort along with its model.
# REVIEW_EFFORT=xhigh
# REVIEW_CODE_EFFORT=max
# REVIEW_VERIFY_EFFORT=xhigh
# REVIEW_FALLBACK_EFFORT=
# REVIEW_VERIFY_FALLBACK_EFFORT=xhigh
REVIEW_TIMEOUT_SECONDS=300
# A review runs in levels. The solution-design level goes first and judges the
# approach: where responsibility sits, what contracts the change establishes, and
# whether the workspace already solves this. Its findings are advisory, posted as
# one pull-request comment, and never block a merge or affect approval. The
# code level then reports line-level defects exactly as before. Each level is
# reviewed by REVIEW_ENGINE and verified by REVIEW_VERIFY_ENGINE, so the design
# level roughly doubles the model invocations the first time a pull request is
# reviewed. It then runs at most once per pull request, so later pushes to the same
# pull request cost what they did before, and --force reviews a design again.
REVIEW_DESIGN_LEVEL=1
# How many solution-design findings one design review may report. Design findings
# dilute faster than line-level ones, so this is deliberately lower than
# MAX_FINDINGS.
MAX_DESIGN_FINDINGS=4
# Advisory documentation level: check whether the change leaves this repository's
# own documentation saying something that is no longer true, for human readers and
# for coding agents alike, and propose the update. It reads the docs it finds in the
# reviewed head rather than being told where they are. Like the design level it is
# advisory, runs at most once per pull request, and adds one review and one
# verification invocation to that first run.
REVIEW_DOCS_LEVEL=1
# How many documentation updates one docs review may propose.
MAX_DOCS_FINDINGS=3
# Head branches whose pull requests never get a design review, as a JSON array of
# case-insensitive globs matched against the whole branch name. A promotion of one
# long-lived branch into another, such as develop into main, carries no new design:
# every change in it was already designed and reviewed on the feature pull request
# that put it there. Set to [] to review the design of promotions too.
DESIGN_EXCLUDED_HEAD_BRANCHES=["develop", "release/*"]
# Budget for one verification pass. Verifying costs work per candidate, because
# each one is checked against the workspace on its own, so the budget is this base
# plus the per-candidate allowance for every candidate in the pass. Every
# verification of one or two candidates has finished well inside a few minutes,
# while passes carrying three and four candidates have exhausted a flat ten
# minutes and lost the whole review with them.
REVIEW_VERIFY_TIMEOUT_SECONDS=900
REVIEW_VERIFY_TIMEOUT_PER_CANDIDATE_SECONDS=180
# How much diff one review reads. A change larger than this is reviewed in part:
# the budget is filled largest changed file first, the rest are named to a human in
# Slack and in the review body, and the approval is withheld because the reviewer
# did not read every line. A pull request where not one file fits is not reviewed at
# all. Raising this trades review quality for coverage: findings dilute across a
# large diff, and a 200 KB change has produced a review with no findings at all.
MAX_DIFF_BYTES=200000
MAX_FINDINGS=10
# How many reviews one pull request may be read in, 1 to 8. Only a change too large
# for MAX_DIFF_BYTES is bundled: the files that did not fit are reviewed in further
# bundles of whole files, so a large change can be read completely and approved
# instead of reviewed in part. Each bundle is another model invocation, which is what
# this caps; whatever the cap leaves over stays deferred and named exactly as before.
# `1` keeps the single review this tool has always done. Measured across 394 pull
# requests, about one percent were large enough for this to matter.
MAX_REVIEW_BUNDLES=4
# Pull requests reviewed at the same time, 1 to 8. Reviews are limited by
# provider capacity rather than local CPU: each slot is another CLI invocation
# against one account, so a high value mostly produces capacity rejections.
# Use 1 to review strictly one at a time.
REVIEW_CONCURRENCY=2
# How long a run's transcript under <state directory>/run-logs is kept, in days,
# from 1 to 365. Each run deletes transcripts older than this window.
RUN_LOG_RETENTION_DAYS=7
# Glob patterns allowed to be skipped only when GitHub omits their patches,
# matched against the full path with `*` crossing directories. GitHub omits a
# patch for a generated file whose diff is too large, most often a lockfile. Such
# a file is reviewed around either way; listing it here says it needs no review,
# which keeps the pull request approvable instead of withholding the approval over
# a file nobody read. Keep this to generated files that carry no reviewable line,
# and remember a bare name matches the repository root only: add the `*/` form as
# well for a monorepo whose workspaces each carry one.
IGNORED_MISSING_PATCH_PATTERNS=["*.tsbuildinfo", "package-lock.json", "*/package-lock.json", "bun.lock", "*/bun.lock", "bun.lockb", "*/bun.lockb", "yarn.lock", "*/yarn.lock", "pnpm-lock.yaml", "*/pnpm-lock.yaml"]

# GitHub inline-comment Markdown and its editable tag-to-field registry.
GITHUB_COMMENT_TEMPLATE_FILE=templates/github-comment.md
GITHUB_COMMENT_TAGS_FILE=templates/github-comment-tags.json

# Optional reviewer identity override. Leave empty to resolve the authenticated
# GitHub CLI user automatically; set it to bypass that lookup when GitHub's
# current-user endpoints are unavailable. Either way every run acts as this account,
# using the GitHub CLI's stored login for it, whichever account `gh` has active.
# A repositories.json entry can name its own "github_account" to be read and
# reviewed as that account instead, such as a private repository only you can see.
GITHUB_REVIEWER_USERNAME=

# Required for live delivery of your own pull requests. When configured, the
# same webhook receives one aggregated alert if a live run finishes with errors.
# A repositories.json entry with "slack": false is never mentioned here: your own
# pull requests in it are reviewed on GitHub, and its errors stay in the run log.
SLACK_WEBHOOK_URL=
