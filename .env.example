# Two delivery gates: set this to 0 and also pass --live.
AUTO_REVIEW_DRY_RUN=1

# Local private configuration and state. Leave unset for the defaults: in a source
# checkout repositories.json beside this file and state under .state/; in an
# installed copy ~/.config/prwarden/repositories.json and ~/.local/state/prwarden.
# Relative paths resolve from the configuration directory.
# REPOSITORIES_FILE=repositories.json
# STATE_FILE=.state/review-state.json
# Which types of review run, in what order, and on which engines, and how much of
# a change one review reads, live in reviews.json beside this file: start from
# reviews.example.json, or let `prwarden setup` write it. A review run that finds no
# reviews.json moves the review settings older releases kept here, REVIEW_ENGINE to
# IGNORED_MISSING_PATCH_PATTERNS, into one, once, keeping this file as
# .env.before-4.0.0; with none here it stops and points to `prwarden setup`. A
# REVIEWS_FILE set here must exist, or the run stops.
# REVIEWS_FILE=reviews.json
# Case-insensitive PR labels that are treated like draft status.
EXCLUDED_PR_LABELS=["in progress"]

# Head branches whose pull requests never get a design review, as a JSON array of
# case-insensitive globs matched against the whole branch name. A promotion of one
# long-lived branch into another, such as develop into main, carries no new design:
# every change in it was already designed and reviewed on the feature pull request
# that put it there. Set to [] to review the design of promotions too.
DESIGN_EXCLUDED_HEAD_BRANCHES=["develop", "release/*"]
# How long a run's transcript under <state directory>/run-logs is kept, in days,
# from 1 to 365. Each run deletes transcripts older than this window.
RUN_LOG_RETENTION_DAYS=7
# How long the review history under <state directory>/history is kept, in days,
# from 1 to 365: one line per pull request per run, read with `prwarden history`.
# Each run deletes history files older than this window.
REVIEW_HISTORY_RETENTION_DAYS=14

# GitHub inline-comment Markdown and its editable tag-to-field registry. Leave
# unset for the defaults in prwarden/templates/; relative paths resolve from the
# configuration directory.
# GITHUB_COMMENT_TEMPLATE_FILE=github-comment.md
# GITHUB_COMMENT_TAGS_FILE=github-comment-tags.json

# Optional reviewer identity override. Leave empty to resolve the authenticated
# GitHub CLI user automatically; set it to bypass that lookup when GitHub's
# current-user endpoints are unavailable. Either way every run acts as this account,
# using the GitHub CLI's stored login for it, whichever account `gh` has active.
# A repositories.json entry can name its own "github_account" to be read and
# reviewed as that account instead, such as a private repository only you can see.
GITHUB_REVIEWER_USERNAME=

# Optional token every GitHub call made as the reviewer uses in place of the GitHub
# CLI's login, for a narrower credential: a fine-grained token limited to the
# reviewed repositories, with Contents read, Pull requests read and write, Issues
# read, Checks read, Commit statuses read, and Actions read, which the checks level
# needs for failed job logs. A repository whose entry names a
# "github_account" keeps that account's GitHub CLI login. The review engines never
# receive it. `prwarden doctor` reports what each credential can do beyond
# reviewing.
# GH_TOKEN=

# Required for live delivery of your own pull requests. When configured, the
# same webhook receives one aggregated alert if a live run finishes with errors.
# A repositories.json entry with "slack": false is never mentioned here: your own
# pull requests in it are reviewed on GitHub, and its errors stay in the run log.
# `prwarden setup --slack` walks through making one and tests it before saving it.
SLACK_WEBHOOK_URL=
