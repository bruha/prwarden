{
  "concurrency": 2,
  "diff": {
    "max_bytes": 200000,
    "max_bundles": 4
  },
  "engines": {
    "kiro": {"env": []}
  },
  "order": ["design", "docs", "code"],
  "types": {
    "design": {
      "max_findings": 4,
      "review": {
        "engines": [
          {"engine": "kiro", "model": "claude-sonnet-5.5", "effort": "high"},
          {"engine": "claude", "model": "claude-opus-5-5", "effort": "xhigh"}
        ],
        "timeout_seconds": 1800
      },
      "verify": {
        "engines": [
          {"engine": "kiro", "model": "gpt-5.6-luna", "effort": "max"},
          {"engine": "codex", "model": "gpt-6.1-terra", "effort": "xhigh"}
        ],
        "timeout_seconds": 900,
        "timeout_per_candidate_seconds": 180
      }
    },
    "docs": {
      "max_findings": 3,
      "review": {
        "engines": [
          {"engine": "kiro", "model": "claude-sonnet-5.5", "effort": "high"},
          {"engine": "claude", "model": "claude-opus-5-5", "effort": "xhigh"}
        ],
        "timeout_seconds": 1800
      },
      "verify": {
        "engines": [
          {"engine": "kiro", "model": "gpt-5.6-luna", "effort": "max"},
          {"engine": "codex", "model": "gpt-6.1-terra", "effort": "xhigh"}
        ],
        "timeout_seconds": 900,
        "timeout_per_candidate_seconds": 180
      }
    },
    "code": {
      "max_findings": 10,
      "review": {
        "engines": [
          {"engine": "kiro", "model": "claude-sonnet-5.5", "effort": "high"},
          {"engine": "claude", "model": "claude-opus-5-5", "effort": "xhigh"}
        ],
        "timeout_seconds": 1800
      },
      "verify": {
        "engines": [
          {"engine": "kiro", "model": "gpt-5.6-luna", "effort": "max"},
          {"engine": "codex", "model": "gpt-6.1-terra", "effort": "xhigh"}
        ],
        "timeout_seconds": 900,
        "timeout_per_candidate_seconds": 180
      }
    },
    "checks": {
      "review": {
        "engines": [
          {"engine": "kiro", "model": "claude-haiku-5.5", "effort": "medium"}
        ],
        "timeout_seconds": 300
      }
    }
  }
}
